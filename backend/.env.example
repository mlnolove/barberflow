ENVIRONMENT=development
DEBUG=true

# Ajuste para seu Postgres local, ou use o do docker-compose (porta 5432)
DATABASE_URL=postgresql+psycopg://barberflow:barberflow@localhost:5432/barberflow

JWT_SECRET_KEY=troque-por-um-valor-aleatorio-longo-e-secreto
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]

# Criptografia em repouso da conta de recebimento (PIX/banco) do dono —
# OBRIGATÓRIO trocar em produção. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=troque-por-uma-chave-fernet-gerada-para-este-ambiente

# Gateway de pagamento (Mercado Pago) — opcional. Sem essas duas variáveis,
# o backend usa um gateway sandbox (aprova na hora, sem cobrar de verdade),
# suficiente para desenvolver/demonstrar sem conta no Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail transacional (reset de senha) — opcional. Sem SMTP_HOST, o e-mail
# só é registrado no log (suficiente pra testar o fluxo sem provedor real).
# Funciona com qualquer SMTP: Gmail, Brevo, SendGrid, Amazon SES etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@barberflow.app
SMTP_USE_TLS=true
